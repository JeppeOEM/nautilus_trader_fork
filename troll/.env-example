# Copy this file to .env and adjust as needed. .env is gitignored (repo-root
# .gitignore's `*.env` pattern) -- personal, never committed.

# Port the ml_signals dashboard listens on (docker-compose's dashboard service,
# and `make dashboard`'s bare-host run). Defaults to 8765 if unset. Set this to
# run on a different port, e.g. to avoid a local conflict.
WEB_PORT=8765

# Opt-in remote-data mode for ml_signals/dashboard.py (Story 12.2). Leave unset when
# dashboard runs co-located with the collector (the VPS default) -- it reads the
# catalog/metrics store straight off local disk exactly as before. Set this to a
# running data_api instance's base URL (e.g. reached via an SSH tunnel from a laptop,
# see README.md's SSH-tunnel section) to have dashboard fetch that same data over HTTP
# instead, so it can run off the VPS with no local catalog/metrics mount at all.
#DATA_API_URL=http://127.0.0.1:9100

# Set true on a desktop/laptop that ALSO uses troll-web/troll-tui/troll-logs
# (~/.zshrc) to reach a real VPS instance over SSH tunnel. Those tunnels forward the
# VPS's redis (6379), data_api (9100) and dozzle (8080) ports to this same machine's
# localhost -- running `make up`'s full local stack (its own redis/data_api/dozzle)
# at the same time would otherwise steal those exact ports out from under the tunnel
# and silently kill the live dashboard/TUI's data feed. Setting this shifts WEB_PORT,
# REDIS_PORT, DATA_API_PORT and DOZZLE_PORT to non-conflicting values (see Makefile)
# so both can run side by side. Never set this on the VPS itself -- its .env stays
# untouched and it keeps using the production ports.
#LOCAL_DEV=true
