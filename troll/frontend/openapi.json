      "get": {
        "summary": "Api Not Found",
        "description": "Catches every unmatched `/api/*` GET request and returns a JSON 404, unconditionally.\n\nWithout this, `app.frontend()`'s `fallback=\"auto\"` SPA-serving behavior silently\nreturns the built `index.html` (200 text/html) for an unmatched `/api/*` path whenever\nthe request carries an `Accept: text/html` header (a real browser's default for\ntop-level navigation) -- confirmed via a real TestClient request this story, not\nassumed. This route is a normal FastAPI path operation, so it always takes priority\nover `app.frontend()`'s low-priority fallback routes regardless of Accept header\n(spine Consistency Conventions: \"an unmatched /api/* path returns a JSON 404, never\nSPA HTML\"). GET-only for now (data_api is a Read-Only Facade, AD-F1/AD-F2) -- if a\nfuture story adds a `PUT`/`POST` route under /api/*, it needs its own such catch-all\nper method, registered ABOVE this block (Starlette matches routes in registration\norder; a route registered after this catch-all for the SAME method would never be\nreached, since this wildcard would already have matched first).",
        "operationId": "api_not_found_api__full_path__get",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Full Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
