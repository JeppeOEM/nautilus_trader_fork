    "/catalog/candles/{iid}": {
      "get": {
        "summary": "Catalog Candles",
        "description": "Dedicated lean candles route -- not a client of /catalog/snapshots above.\n\nThat route returns full order-book depth (bid/ask price+size arrays, up to 20\nlevels each) needed for Lines mode; a candlestick pane only needs 4 scalar OHLC\nfields per second. For a 4-hour window /catalog/snapshots serializes to ~12MB,\nwhich took 30-60s over an SSH tunnel -- this route aggregates to candle bars here,\non the box that holds the catalog, so only a few KB crosses the network.",
        "operationId": "catalog_candles_catalog_candles__iid__get",
        "parameters": [
          {
            "name": "iid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Iid"
            }
          },
          {
            "name": "start_ns",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Start Ns"
            }
          },
          {
            "name": "end_ns",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "End Ns"
            }
          },
          {
            "name": "bar_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 60,
              "title": "Bar Seconds"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "title": "Response Catalog Candles Catalog Candles  Iid  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
