# Copy this file to .env and adjust as needed. .env is gitignored (repo-root
# .gitignore's `*.env` pattern) -- personal, never committed.

# Set true on a desktop/laptop that ALSO uses platform-web/platform-tui/platform-logs
# (~/.zshrc) to reach a real VPS instance over SSH tunnel. Those tunnels forward the
# VPS's redis (6379), data_api (9100) and dozzle (8080) ports to this same machine's
# localhost -- running `make up`'s full local stack (its own redis/data_api/dozzle)
# at the same time would otherwise steal those exact ports out from under the tunnel
# and silently kill the live UI/TUI's data feed. Setting this shifts
# REDIS_PORT, DATA_API_PORT and DOZZLE_PORT to non-conflicting values (see Makefile)
# so both can run side by side. Never set this on the VPS itself -- its .env stays
# untouched and it keeps using the production ports.
#LOCAL_DEV=true

# Alert delivery to Telegram (data_api). Create a bot with @BotFather for the token; get your
# chat id by messaging the bot then opening https://api.telegram.org/bot<token>/getUpdates.
#TELEGRAM_BOT_TOKEN=...
#TELEGRAM_CHAT_ID=...

# Catalog backup: the rclone remote name (from `rclone config`, stored in ~/.config/rclone --
# never in this repo) and bucket. Read by the `archive` compose service's nightly backup step, which
# runs only with `backup_enabled = true` in archive/config.toml (committed false until off-site
# storage exists), and by `make backup-catalog` (both run `python3 -m archive.backup_catalog`, with
# the image's rclone, in the `archive` container; restart it with `docker compose up -d archive`
# after a change). See README "Nightly maintenance". Unset with the backup enabled = the service
# refuses to start (`archive.config_invalid`); unset for a manual run = exit 1
# (`archive.backup_not_configured`); never a silent skip. Bare values: no quotes, no trailing ':'.
#RCLONE_REMOTE=
#RCLONE_BUCKET=

# The operator's rclone config directory, mounted read-only into the `archive` service at
# /app/rclone (RCLONE_CONFIG=/app/rclone/rclone.conf). Default ~/.config/rclone; set it only when
# rclone.conf lives elsewhere. Read-only: use a remote with static keys (R2, B2), since a refreshed
# OAuth token could not be saved.
#RCLONE_CONFIG_DIR=/home/you/.config/rclone
